.env
credentials.json
credentials/
reports/
*.bak
workspace/data/**/*.bak
__pycache__/
*.pyc
.pytest_cache/
# ランタイム生成ファイル（スクレイプログ等）
/logs/

# 一時スクレイプログ
kakaku_*.log
seo_gen*.log

# Steam raw データ（容量大）
workspace/data/steam/raw/

# 組み合わせページ（グラボ×ケース）は保存しない。
# アクセスされたときに app.py がその場で作るので、ファイルは要らない。
# 2026-09-17: 手違いで16万ファイル・1.4GB が保存されていたのを消した。
# ハブページ static/compat/index.html だけは保存する。
static/compat/*.html
!static/compat/index.html
static/compat/gpu/
static/compat/case/

# 一時画像（Twitter Bot）
scripts/temp_images/
scripts/test_images/
static/tweet_images/price-alert-*.png

# 一時スクリプト
tmp_*.py
tmp_*.ps1
tmp_*.json
tmp_*.txt
tmp_*.bat
tmp_*.html

